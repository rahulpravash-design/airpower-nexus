# ---- backend (airops.api) ----
# Comma-separated CORS origins (default "*": fine for the local demo)
AIROPS_CORS_ORIGINS=*
# Directory for benchmark CSV/JSON output (default: airops/results)
# AIROPS_RESULTS_DIR=airops/results
# Serve the built web app from the API process (default: web/dist if it exists)
# AIROPS_WEB_DIST=web/dist

# ---- web (Vite) ----
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000
